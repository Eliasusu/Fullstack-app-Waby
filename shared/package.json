{
  "name": "@waby/shared",
  "private": true,
  "version": "0.0.0",
  "description": "Contrato de la API de Waby: esquemas Zod, tipos y enums compartidos por la API y el client",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "dev": "tsc -p ./tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p ./tsconfig.json"
  },
  "dependencies": {
    "zod": "3.23.8"
  },
  "devDependencies": {
    "typescript": "5.5.2"
  }
}
