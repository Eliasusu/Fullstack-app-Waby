{
  "name": "waby",
  "private": true,
  "description": "Waby: app para crear ejercicios, planificar entrenamientos y seguir la sobrecarga progresiva",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:shared": "pnpm --filter @waby/shared dev",
    "dev:api": "pnpm build:shared && pnpm --filter @waby/api dev:server",
    "dev:client": "pnpm build:shared && pnpm --filter @waby/client dev:client",
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @waby/shared build",
    "build:api": "pnpm build:shared && pnpm --filter @waby/api build",
    "build:client": "pnpm build:shared && pnpm --filter @waby/client build",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "lint": "pnpm --filter @waby/client lint",
    "test": "pnpm build:shared && pnpm --filter @waby/api test"
  }
}
