# Copiá este archivo a .env y completá los valores. .env no se commitea.

# Entorno: development | test | production
NODE_ENV=development
PORT=3000

# MySQL (lo levanta docker compose con estos mismos valores)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=waby
DB_TEST_NAME=waby_test
DB_USER=waby
DB_PASSWORD=cambiame
DB_ROOT_PASSWORD=cambiame-root

# Clave para firmar los JWT. Obligatoria, mínimo 32 caracteres.
# Generala con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Usuarios que crea el seed (pnpm --filter @waby/api seed)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@waby.local
SEED_ADMIN_PASSWORD=cambiame-admin
SEED_DEMO_USERNAME=demo
SEED_DEMO_EMAIL=demo@waby.local
SEED_DEMO_PASSWORD=cambiame-demo
